# Safety: this project is paper-only. The application refuses any non-paper base URL.
TRADING_MODE=paper
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_ACCOUNT_ID=
ALPACA_COMPETITION_STARTING_BALANCE=100000
LIVE_TRADING_ALLOWED=false
ORDER_SUBMISSION_ENABLED=false

# Server-side only. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Public routing only; contains no credentials.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

